# Pushover credentials for the afk-pushover skill.
# Copy this file to ONE of:
#   ~/.config/afk-pushover/.env     (recommended — user-level, works in every project)
#   <skill dir>/.env.local          (fallback — skill-local)
# ...and fill in your values.
#
# Get them from https://pushover.net/:
#   PUSHOVER_USER   = your account's User Key (shown on the dashboard, ~30 chars)
#   PUSHOVER_TOKEN  = an Application/API Token (Create an Application, ~30 chars)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Optional: Soft-Check idle threshold in seconds. Default 1800 (30 min).
# The skill appends "Still AFK? Reply BTK if back." to pages sent after this
# much silence from the human.
SOFT_CHECK_IDLE_SECONDS=1800
